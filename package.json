{
  "name": "professional-portfolio",
  "private": true,
  "version": "1.0.0",
  "description": "A premium, high-performance portfolio website showcasing professional work with stunning visual aesthetics and seamless user experience",
  "author": "Emre Dursun <info.emredursun@gmail.com>",
  "homepage": "https://emredursun.nl",
  "repository": {
    "type": "git",
    "url": "https://github.com/emredursun/professional-portfolio.git"
  },
  "keywords": [
    "portfolio",
    "react",
    "typescript",
    "tailwindcss",
    "vite",
    "automation-engineer",
    "personal-website",
    "responsive-design",
    "dark-mode"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "generate:sitemap": "node scripts/generate-sitemap.js",
    "generate:profile-readme": "node scripts/generate-profile-readme.js",
    "publish:profile-readme": "npm run generate:profile-readme && node scripts/publish-profile-readme.js",
    "optimize:images": "node scripts/optimize-images.js",
    "prebuild": "npm run generate:sitemap && npm run generate:profile-readme",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "@fortawesome/fontawesome-free": "^6.7.2",
    "@types/three": "^0.181.0",
    "framer-motion": "^12.23.24",
    "fuse.js": "^7.1.0",
    "gsap": "^3.13.0",
    "i18next": "^25.7.3",
    "i18next-browser-languagedetector": "^8.2.0",
    "i18next-http-backend": "^4.0.4",
    "lenis": "^1.3.15",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^16.5.0",
    "react-router-dom": "^7.11.0",
    "three": "^0.181.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^3.2.7",
    "autoprefixer": "^10.4.22",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.6",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.18",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=22"
  }
}
