{
  "name": "professional-portfolio",
  "private": true,
  "version": "1.0.0",
  "description": "A premium, high-performance portfolio website showcasing professional work with stunning visual aesthetics and seamless user experience",
  "author": "Emre Dursun <info.emredursun@gmail.com>",
  "homepage": "https://emredursun.nl",
  "repository": {
    "type": "git",
    "url": "https://github.com/emredursun/professional-portfolio.git"
  },
  "keywords": [
    "portfolio",
    "react",
    "typescript",
    "tailwindcss",
    "vite",
    "automation-engineer",
    "personal-website",
    "responsive-design",
    "dark-mode"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "generate:sitemap": "node scripts/generate-sitemap.js",
    "generate:profile-readme": "node scripts/generate-profile-readme.js",
    "generate:cv": "node scripts/generate-cv.js",
    "generate:icons": "node scripts/subset-icons.js",
    "publish:profile-readme": "npm run generate:profile-readme && node scripts/publish-profile-readme.js",
    "optimize:images": "node scripts/optimize-images.js",
    "prebuild": "npm run generate:sitemap && npm run generate:profile-readme",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "postbuild": "node scripts/write-version.js && node scripts/prerender-routes.js && node scripts/generate-agent-profile.js"
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "framer-motion": "^12.23.24",
    "fuse.js": "^7.1.0",
    "i18next": "^25.7.3",
    "i18next-browser-languagedetector": "^8.2.0",
    "i18next-http-backend": "^4.0.4",
    "lenis": "^1.3.15",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^16.5.0",
    "react-router-dom": "^7.11.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.5",
    "@fortawesome/fontawesome-free": "^6.7.2",
    "@jsonresume/schema": "^1.7.0",
    "@playwright/test": "^1.64.1",
    "@shikijs/transformers": "4.5.0",
    "@tailwindcss/container-queries": "^0.1.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.14.0",
    "@types/picomatch": "^4.0.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^5.0.5",
    "autoprefixer": "^10.4.22",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^26.1.0",
    "knip": "^5.88.1",
    "markdown-it": "15.0.2",
    "picomatch": "^4.0.7",
    "postcss": "^8.5.6",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "shiki": "4.5.0",
    "subset-font": "2.9.0",
    "tailwindcss": "^3.4.18",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.72.0",
    "vite": "^6.2.0",
    "vitest": "^5.0.5",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "harfbuzzjs": "1.6.2"
  }
}
