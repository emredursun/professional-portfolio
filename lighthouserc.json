{
  "ci": {
    "collect": {
      "startServerCommand": "npx vite preview --port 4181 --strictPort",
      "startServerReadyPattern": "4181",
      "url": [
        "http://localhost:4181/about",
        "http://localhost:4181/projects",
        "http://localhost:4181/contact"
      ],
      "numberOfRuns": 5,
      "settings": {
        "preset": "desktop",
        "chromeFlags": "--headless=new --no-sandbox"
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": "^(?!.*/projects$).*$",
          "assertions": {
            "categories:performance": [
              "error",
              {
                "minScore": 0.9,
                "aggregationMethod": "median-run"
              }
            ],
            "categories:accessibility": [
              "error",
              {
                "minScore": 1
              }
            ],
            "categories:best-practices": [
              "error",
              {
                "minScore": 1
              }
            ],
            "categories:seo": [
              "error",
              {
                "minScore": 1
              }
            ],
            "largest-contentful-paint": [
              "error",
              {
                "maxNumericValue": 2000
              }
            ],
            "cumulative-layout-shift": [
              "error",
              {
                "maxNumericValue": 0.1
              }
            ],
            "total-blocking-time": [
              "error",
              {
                "maxNumericValue": 200,
                "aggregationMethod": "median-run"
              }
            ],
            "resource-summary:script:size": [
              "error",
              {
                "maxNumericValue": 460000
              }
            ],
            "resource-summary:total:size": [
              "error",
              {
                "maxNumericValue": 900000
              }
            ],
            "resource-summary:third-party:count": [
              "error",
              {
                "maxNumericValue": 2
              }
            ]
          }
        },
        {
          "matchingUrlPattern": ".*/projects$",
          "assertions": {
            "categories:performance": [
              "error",
              {
                "minScore": 0.9,
                "aggregationMethod": "median-run"
              }
            ],
            "categories:accessibility": [
              "error",
              {
                "minScore": 1
              }
            ],
            "categories:best-practices": [
              "error",
              {
                "minScore": 1
              }
            ],
            "categories:seo": [
              "error",
              {
                "minScore": 1
              }
            ],
            "largest-contentful-paint": [
              "error",
              {
                "maxNumericValue": 2000
              }
            ],
            "cumulative-layout-shift": [
              "error",
              {
                "maxNumericValue": 0.1
              }
            ],
            "total-blocking-time": [
              "error",
              {
                "maxNumericValue": 200,
                "aggregationMethod": "median-run"
              }
            ],
            "resource-summary:script:size": [
              "error",
              {
                "maxNumericValue": 460000
              }
            ],
            "resource-summary:total:size": [
              "error",
              {
                "maxNumericValue": 900000
              }
            ],
            "resource-summary:third-party:count": [
              "error",
              {
                "maxNumericValue": 7
              }
            ]
          }
        }
      ]
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
