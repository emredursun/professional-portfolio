{
  "ci": {
    "collect": {
      "startServerCommand": "npx vite preview --port 4181 --strictPort",
      "startServerReadyPattern": "4181",
      "url": [
        "http://localhost:4181/about",
        "http://localhost:4181/projects",
        "http://localhost:4181/contact",
        "http://localhost:4181/blog",
        "http://localhost:4181/blog/sample-a-green-test",
        "http://localhost:4181/blog/sample-hypothesis-note",
        "http://localhost:4181/tr/blog",
        "http://localhost:4181/tr/blog/sample-a-green-test",
        "http://localhost:4181/nl/blog/sample-a-green-test",
        "http://localhost:4181/blog/now"
      ],
      "numberOfRuns": 5,
      "settings": {
        "preset": "desktop",
        "chromeFlags": "--headless=new --no-sandbox"
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": "^(?!.*/(?:projects$|blog(?:/|$))).*$",
          "assertions": {
            "categories:performance": [
              "error",
              {
                "minScore": 0.9,
                "aggregationMethod": "median-run"
              }
            ],
            "categories:accessibility": [
              "error",
              {
                "minScore": 1
              }
            ],
            "categories:best-practices": [
              "error",
              {
                "minScore": 1
              }
            ],
            "categories:seo": [
              "error",
              {
                "minScore": 1
              }
            ],
            "largest-contentful-paint": [
              "error",
              {
                "maxNumericValue": 2000
              }
            ],
            "cumulative-layout-shift": [
              "error",
              {
                "maxNumericValue": 0.1
              }
            ],
            "total-blocking-time": [
              "error",
              {
                "maxNumericValue": 200,
                "aggregationMethod": "median-run"
              }
            ],
            "resource-summary:script:size": [
              "error",
              {
                "maxNumericValue": 460000
              }
            ],
            "resource-summary:total:size": [
              "error",
              {
                "maxNumericValue": 900000
              }
            ],
            "resource-summary:third-party:count": [
              "error",
              {
                "maxNumericValue": 2
              }
            ]
          }
        },
        {
          "matchingUrlPattern": ".*/projects$",
          "assertions": {
            "categories:performance": [
              "error",
              {
                "minScore": 0.9,
                "aggregationMethod": "median-run"
              }
            ],
            "categories:accessibility": [
              "error",
              {
                "minScore": 1
              }
            ],
            "categories:best-practices": [
              "error",
              {
                "minScore": 1
              }
            ],
            "categories:seo": [
              "error",
              {
                "minScore": 1
              }
            ],
            "largest-contentful-paint": [
              "error",
              {
                "maxNumericValue": 2000
              }
            ],
            "cumulative-layout-shift": [
              "error",
              {
                "maxNumericValue": 0.1
              }
            ],
            "total-blocking-time": [
              "error",
              {
                "maxNumericValue": 200,
                "aggregationMethod": "median-run"
              }
            ],
            "resource-summary:script:size": [
              "error",
              {
                "maxNumericValue": 460000
              }
            ],
            "resource-summary:total:size": [
              "error",
              {
                "maxNumericValue": 900000
              }
            ],
            "resource-summary:third-party:count": [
              "error",
              {
                "maxNumericValue": 7
              }
            ]
          }
        },
        {
          "matchingUrlPattern": ".*/blog(?:/.*)?$",
          "assertions": {
            "categories:performance": [
              "error",
              { "minScore": 0.95, "aggregationMethod": "median-run" }
            ],
            "categories:accessibility": ["error", { "minScore": 1 }],
            "categories:best-practices": ["error", { "minScore": 1 }],
            "document-title": ["error", { "minScore": 1 }],
            "meta-description": ["error", { "minScore": 1 }],
            "http-status-code": ["error", { "minScore": 1 }],
            "link-text": ["error", { "minScore": 1 }],
            "crawlable-anchors": ["error", { "minScore": 1 }],
            "canonical": ["error", { "minScore": 1 }],
            "largest-contentful-paint": [
              "error",
              { "maxNumericValue": 2000, "aggregationMethod": "median-run" }
            ],
            "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }],
            "total-blocking-time": [
              "error",
              { "maxNumericValue": 100, "aggregationMethod": "median-run" }
            ],
            "resource-summary:script:size": ["error", { "maxNumericValue": 20000 }],
            "resource-summary:total:size": ["error", { "maxNumericValue": 300000 }],
            "resource-summary:third-party:count": ["error", { "maxNumericValue": 0 }]
          }
        }
      ]
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
